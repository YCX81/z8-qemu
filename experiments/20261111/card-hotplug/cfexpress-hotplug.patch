+/* Runtime CFexpress pull/insert. Removal clears the polled slot bit (17a00044
+ * bit1) and the wrapper link input, and cold-resets the endpoint: a pulled card
+ * loses power, so whatever the firmware finds on reinsertion is a fresh
+ * controller. No PHY/LTSSM or surprise-down AER is modelled. */
+static void z9_cfexpress_set_present(NikonZ9State *s, bool present)
+{
+    PCIBus *bus = &PCI_BRIDGE(z9_pcie_root(s))->sec_bus;
+    PCIDevice *ep = pci_find_device(bus, pci_bus_num(bus), PCI_DEVFN(0, 0));
+    if (present == !s->cfexpress_removed) {
+        return;
+    }
+    s->cfexpress_events++;
+    if (!present) {
+        s->cfexpress_removed = true;
+        if (ep) {
+            device_cold_reset(DEVICE(ep));
+        }
+    } else {
+        s->cfexpress_removed = false;
+    }
+    s->pcie_link_status_reads = 0; /* log the next link queries again */
+    fprintf(stderr, "Z8_CFEXPRESS %s endpoint=%u event=%lu\n", present ? "inserted" : "removed",
+            ep != NULL, (unsigned long)s->cfexpress_events);
+}
