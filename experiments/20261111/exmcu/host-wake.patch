+/* Host-peer MAIN supply. Without the native EX nothing returns MAIN power
+ * after the stock standby power-down; a driver cuts (false) and returns (true)
+ * it here, mirroring z8_mcu_main_supply: MAIN CPUs off, then power-on reset of
+ * the modelled latches, GIC cold reset and CPU0 architectural reset.
+ * DRAM, card and peer state are retained. */
+static void z8_host_supply_return(void *opaque);
+static bool get_main_supply(Object *obj, Error **errp)
+{
+    return !NIKON_Z9_LAB(obj)->host_supply_off;
+}
+
+static void set_main_supply(Object *obj, bool value, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    if (s->native_mcu) {
+        error_setg(errp, "main-supply: the native EX owns MAIN supply (mcu-main-supply-pin)");
+        return;
+    }
+    if (!s->host_main_gic) {
+        if (!value) { error_setg(errp, "main-supply: machine not realized"); }
+        return;
+    }
+    if (!value && !s->host_supply_off) {
+        CPUState *cs;
+        s->host_supply_off = true; s->host_supply_cuts++;
+        CPU_FOREACH(cs) {
+            ARMCPU *cpu = ARM_CPU(cs);
+            if (!arm_feature(&cpu->env, ARM_FEATURE_M)) {
+                arm_set_cpu_off(arm_cpu_mp_affinity(cpu));
+            }
+        }
+        error_report("Z8_HOST_SUPPLY cut ns=%"PRId64" powerdowns=%"PRIu64,
+                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), s->main_powerdowns);
+    } else if (value && s->host_supply_off && !s->host_supply_return_pending) {
+        s->host_supply_return_pending = true;
+        z8_host_supply_return(s);
+    }
+}
+
+static void z8_host_supply_return(void *opaque)
+{
+    NikonZ9State *s = opaque;
+    ARMCPU *cpu0 = ARM_CPU(arm_get_cpu_by_id(0));
+    if (cpu0->power_state != PSCI_OFF) {
+        /* The asynchronous cut has not run yet (VM stopped or same QMP batch). */
+        if (!s->host_supply_timer) {
+            s->host_supply_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, z8_host_supply_return, s);
+        }
+        timer_mod(s->host_supply_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000000);
+        return;
+    }
+    {
+        s->host_supply_return_pending = false;
+        s->host_supply_off = false; s->host_supply_resets++;
+        z8_main_power_on_reset(s);
+        device_cold_reset(s->host_main_gic);
+        int rc = arm_set_cpu_on_and_reset(0);
+        error_report("Z8_HOST_SUPPLY return ns=%"PRId64" architectural reset rc=%d; card/RAM retained",
+                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), rc);
+    }
+}
+
+static char *get_main_power_state(Object *obj, Error **errp)
+{
+    NikonZ9State *s = NIKON_Z9_LAB(obj);
+    return g_strdup_printf("{\"powerdowns\":%"PRIu64",\"supply_off\":%s,\"cuts\":%"PRIu64",\"resets\":%"PRIu64",\"native_mcu\":%s}",
+        s->main_powerdowns, s->host_supply_off ? "true" : "false",
+        s->host_supply_cuts, s->host_supply_resets, s->native_mcu ? "true" : "false");
+}
