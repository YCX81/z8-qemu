+    if (!write) { *value=0; }
+    if (!w->busy) {
+        w->regs[W5P_REG(0x70)]=0;
+        w->regs[W5P_REG(0x108)]=0;
+        w->regs[W5P_REG(0x10c)]=0x100;
+    }
+    return true;
+}
