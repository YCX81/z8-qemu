diff --git a/hw/arm/nikon-dma-observe.h b/hw/arm/nikon-dma-observe.h
--- /dev/null
+++ b/hw/arm/nikon-dma-observe.h
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Optional board-write provenance, adapted from WonderLantern z9-qemu shared441.
+ * No address translation, write replacement, completion, interrupt or
+ * guest-state repair. Input is an explicit interval inside one RAM-backed
+ * window of this machine: work RAM, or the allocated image-bank span that
+ * holds the Z8 C30 history block pool. No firmware addresses are compiled in.
+ * Only writes issued by this board through address_space_write() or
+ * cpu_physical_memory_write() are observed; guest CPU stores are not. */
+#define WL_DMA_OBSERVER_LIMIT 4096
+#define WL_DMA_WORK_RAM UINT64_C(0xa00000000)
+static uint64_t wl_dma_observer_low, wl_dma_observer_high;
+static uint64_t wl_dma_observer_work_end;
+static bool wl_dma_observer_banks;
+static gint wl_dma_observer_records;
+
+/* Image banks leave a small unbacked gap; sampling must not read it as MMIO. */
+static bool wl_dma_observer_backed(uint64_t start, uint64_t bytes)
+{
+    if (start >= WL_DMA_WORK_RAM && start + bytes <= wl_dma_observer_work_end) {
+        return true;
+    }
+    for (unsigned i = 0; wl_dma_observer_banks && i < ARRAY_SIZE(image_bank_ranges); i++) {
+        if (start >= image_bank_ranges[i].base &&
+            start + bytes <= image_bank_ranges[i].end) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* Called once at machine creation, so a bad interval fails before any run. */
+static void wl_dma_observer_configure(uint64_t work_ram_bytes, bool image_banks)
+{
+    const char *text = g_getenv("WL_DMA_WRITE_OBSERVE");
+    uint64_t low = 0, high = 0;
+    char tail;
+    if (!text) {
+        return;
+    }
+    uint64_t bank_low = image_bank_ranges[0].base;
+    uint64_t bank_high = image_bank_ranges[ARRAY_SIZE(image_bank_ranges) - 1].end;
+    uint64_t work_end = WL_DMA_WORK_RAM + work_ram_bytes;
+    bool parsed = sscanf(text, "%"SCNx64":%"SCNx64"%c", &low, &high, &tail) == 2 &&
+                  low < high;
+    bool work = parsed && low >= WL_DMA_WORK_RAM && high <= work_end;
+    bool banks = parsed && image_banks && low >= bank_low && high <= bank_high;
+    if (!work && !banks) {
+        error_report("WL_DMA_WRITE_OBSERVE requires low:high inside work RAM "
+                     "0x%"PRIx64"..0x%"PRIx64" or, with image-bank-model=on, "
+                     "image banks 0x%"PRIx64"..0x%"PRIx64,
+                     WL_DMA_WORK_RAM, work_end, bank_low, bank_high);
+        exit(1);
+    }
+    wl_dma_observer_low = low;
+    wl_dma_observer_high = high;
+    wl_dma_observer_work_end = work_end;
+    wl_dma_observer_banks = image_banks;
+}
+
+static void wl_dma_observer_record(AddressSpace *as, hwaddr address,
+    MemTxAttrs attrs, const void *buffer, hwaddr bytes, int result,
+    const char *producer, unsigned line)
+{
+    uint64_t low = wl_dma_observer_low, high = wl_dma_observer_high;
+    if (!high || as != &address_space_memory || !bytes || address >= high ||
+        bytes > UINT64_MAX - address || address + bytes <= low) {
+        return;
+    }
+    gint index = g_atomic_int_add(&wl_dma_observer_records, 1);
+    if (index > WL_DMA_OBSERVER_LIMIT) { return; }
+    if (index == WL_DMA_OBSERVER_LIMIT) {
+        fprintf(stderr, "WL_DMA_OBSERVE {\"limit_reached\":true,\"limit\":%d}\n",
+                WL_DMA_OBSERVER_LIMIT);
+        return;
+    }
+    uint64_t start = MAX(address, low), end = MIN(address + bytes, high);
+    unsigned n = MIN(end - start, 64);
+    const uint8_t *expected = (const uint8_t *)buffer + (start - address);
+    uint8_t actual[64];
+    bool backed = wl_dma_observer_backed(start, n);
+    bool matches = backed &&
+                   address_space_read(as, start, attrs, actual, n) == MEMTX_OK &&
+                   !memcmp(actual, expected, n);
+    GString *out = g_string_new(NULL);
+    g_string_append_printf(out, "WL_DMA_OBSERVE {\"index\":%d,\"producer\":\"%s\","
+        "\"line\":%u,\"virtual_ns\":%"PRId64",\"address\":\"0x%"PRIx64"\","
+        "\"bytes\":%"PRIu64",\"api_result\":%d,\"sample_address\":\"0x%"PRIx64"\","
+        "\"sample_ram_backed\":%s,\"sample_matches_RAM\":%s,\"sample_hex\":\"",
+        index, producer, line, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+        (uint64_t)address, (uint64_t)bytes, result, start,
+        backed ? "true" : "false", matches ? "true" : "false");
+    for (unsigned i = 0; i < n; i++) { g_string_append_printf(out, "%02x", expected[i]); }
+    g_string_append(out, "\"}\n");
+    fputs(out->str, stderr);
+    g_string_free(out, true);
+}
+
+static MemTxResult wl_observed_address_space_write(AddressSpace *as, hwaddr address,
+    MemTxAttrs attrs, const void *buffer, hwaddr bytes, const char *producer, unsigned line)
+{
+    MemTxResult result = address_space_write(as, address, attrs, buffer, bytes);
+    wl_dma_observer_record(as, address, attrs, buffer, bytes, result, producer, line);
+    return result;
+}
+
+static void wl_observed_cpu_physical_write(hwaddr address, const void *buffer,
+    hwaddr bytes, const char *producer, unsigned line)
+{
+    cpu_physical_memory_write(address, buffer, bytes);
+    /* The void API has no completion result. Its sampled RAM check is explicit;
+     * -1 must not be interpreted as either a successful or failed transaction. */
+    wl_dma_observer_record(&address_space_memory, address, MEMTXATTRS_UNSPECIFIED,
+                           buffer, bytes, -1, producer, line);
+}
+
+#define address_space_write(as, address, attrs, buffer, bytes) \
+    wl_observed_address_space_write(as, address, attrs, buffer, bytes, __func__, __LINE__)
+#define cpu_physical_memory_write(address, buffer, bytes) \
+    wl_observed_cpu_physical_write(address, buffer, bytes, __func__, __LINE__)
diff --git a/hw/arm/nikon-w5p-codec.h b/hw/arm/nikon-w5p-codec.h
--- /dev/null
+++ b/hw/arm/nikon-w5p-codec.h
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Authored functional HEVC/AVC backend. Uses installed public x265/x264 APIs;
+ * no Nikon firmware, microcode or compression implementation is included.
+ * Input planes are immutable actual DMA snapshots, never preview upshifts.
+ */
+#include <x265.h>
+#include <x264.h>
+
+typedef struct W5pCodec {
+    const x265_api *api;
+    x265_param *param;
+    x265_encoder *encoder;
+    x264_param_t *avc_param;
+    x264_t *avc_encoder;
+    unsigned codec_mode; /* Explicit Wave5 convention: 1 HEVC, 3 AVC. */
+    unsigned width, height, depth;
+    uint64_t frames;
+} W5pCodec;
+
+static void w5p_hevc_close(W5pCodec *codec)
+{
+    if (!codec) { return; }
+    if (codec->avc_encoder) { x264_encoder_close(codec->avc_encoder); }
+    if (codec->avc_param) {
+        x264_param_cleanup(codec->avc_param);
+        g_free(codec->avc_param);
+    }
+    if (codec->encoder) { codec->api->encoder_close(codec->encoder); }
+    if (codec->param) { codec->api->param_free(codec->param); }
+    g_free(codec);
+}
+
+static W5pCodec *w5p_hevc_open(unsigned width, unsigned height, unsigned depth,
+                               unsigned fps_n, unsigned fps_d, bool lossless,
+                               unsigned keyframe_period, unsigned level, bool high_tier)
+{
+    if (!width || !height || (width | height) & 1 || width > 8192 || height > 8192 ||
+        (depth != 8 && depth != 10) || !fps_n || !fps_d ||
+        (level && level != 30 && level != 60 && level != 63 && level != 90 &&
+         level != 93 && level != 120 && level != 123 && level != 150 &&
+         level != 153 && level != 156 && level != 180 && level != 183 && level != 186) ||
+        (high_tier && level < 120)) { return NULL; }
+    const x265_api *api = x265_api_get(depth);
+    if (!api || (unsigned)api->bit_depth != depth || api->sizeof_param != sizeof(x265_param) ||
+        api->sizeof_picture != sizeof(x265_picture)) { return NULL; }
+    W5pCodec *codec = g_new0(W5pCodec, 1);
+    codec->api = api;
+    codec->param = api->param_alloc();
+    if (!codec->param || api->param_default_preset(codec->param, "ultrafast", "zerolatency") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    x265_param *p = codec->param;
+    p->sourceWidth = width; p->sourceHeight = height;
+    p->internalCsp = X265_CSP_I420; p->internalBitDepth = depth;
+    p->fpsNum = fps_n; p->fpsDenom = fps_d;
+    /* Wave5/HEVC uses general_level_idc (three times level * 10).
+     * Preserve the requested tier in actual VPS/SPS and muxed hvcC. */
+    p->levelIdc = level / 3; p->bHighTier = high_tier;
+    p->frameNumThreads = 1;
+    p->bframes = 0; p->lookaheadDepth = 0;
+    p->bRepeatHeaders = 0; p->bAnnexB = 1;
+    /* Native movie packets retain the advertised AUD length on every
+     * access unit. Omitting it lets the mux overwrite VCL bytes at +7. */
+    p->bEnableAccessUnitDelimiters = 1;
+    if (keyframe_period) {
+        p->keyframeMax = keyframe_period; p->keyframeMin = 1;
+        p->scenecutThreshold = 0; p->bOpenGOP = 0;
+    }
+    p->bEnableWavefront = 0; p->bEnablePsnr = 0; p->bEnableSsim = 0;
+    p->logLevel = X265_LOG_ERROR;
+    p->bLossless = lossless;
+    p->rc.rfConstant = 18;
+    if (api->param_parse(p, "pools", "none") < 0 ||
+        api->param_apply_profile(p, depth == 10 ? "main10" : "main") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    codec->encoder = api->encoder_open(p);
+    if (!codec->encoder) { w5p_hevc_close(codec); return NULL; }
+    codec->width = width; codec->height = height; codec->depth = depth; codec->codec_mode = 1;
+    return codec;
+}
+
+static W5pCodec *w5p_video_open(unsigned mode, unsigned width, unsigned height, unsigned depth,
+                                unsigned fps_n, unsigned fps_d, bool lossless,
+                                const unsigned crop[4], unsigned keyframe_period,
+                                unsigned level, bool high_tier)
+{
+    if (mode == 1) { return w5p_hevc_open(width, height, depth, fps_n, fps_d, lossless, keyframe_period, level, high_tier); }
+    if (mode != 3 || !width || !height || (width | height) & 1 ||
+        width > 8192 || height > 8192 || (depth != 8 && depth != 10) || !fps_n || !fps_d) {
+        return NULL;
+    }
+    W5pCodec *codec = g_new0(W5pCodec, 1);
+    codec->avc_param = g_new0(x264_param_t, 1);
+    x264_param_t *p = codec->avc_param;
+    if (x264_param_default_preset(p, "ultrafast", "zerolatency") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    p->i_width = width; p->i_height = height; p->i_bitdepth = depth;
+    p->i_csp = X264_CSP_I420 | (depth > 8 ? X264_CSP_HIGH_DEPTH : 0);
+    /* Keep the complete coded DMA surface. SPS cropping controls the
+     * displayed rectangle, including each 4:2:0 chroma edge. */
+    p->crop_rect.i_left = crop[0]; p->crop_rect.i_top = crop[1];
+    p->crop_rect.i_right = crop[2]; p->crop_rect.i_bottom = crop[3];
+    p->i_fps_num = fps_n; p->i_fps_den = fps_d;
+    p->i_timebase_num = fps_d; p->i_timebase_den = fps_n;
+    p->i_threads = 1; p->i_lookahead_threads = 1;
+    p->i_bframe = 0; p->rc.i_lookahead = 0; p->b_vfr_input = 0;
+    p->b_repeat_headers = 0; p->b_annexb = 1; p->b_aud = 1;
+    p->i_log_level = X264_LOG_ERROR;
+    if (keyframe_period) {
+        p->i_keyint_max = keyframe_period; p->i_keyint_min = 1;
+        p->i_scenecut_threshold = 0; p->b_open_gop = 0;
+    }
+    if (lossless) { p->rc.i_rc_method = X264_RC_CQP; p->rc.i_qp_constant = 0; }
+    else { p->rc.i_rc_method = X264_RC_CRF; p->rc.f_rf_constant = 18; }
+    if (x264_param_apply_profile(p, lossless ? "high444" : depth == 10 ? "high10" : "high") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    codec->avc_encoder = x264_encoder_open(p);
+    if (!codec->avc_encoder) { w5p_hevc_close(codec); return NULL; }
+    codec->width = width; codec->height = height; codec->depth = depth; codec->codec_mode = mode;
+    return codec;
+}
+
+static bool w5p_header_nal(GByteArray *output, const uint8_t *data,
+                          unsigned bytes, uint32_t *length)
+{
+    unsigned prefix = bytes >= 4 && !memcmp(data, "\0\0\0\1", 4) ? 4 :
+                      bytes >= 3 && !memcmp(data, "\0\0\1", 3) ? 3 : 0;
+    if (!prefix || bytes <= prefix) { return false; }
+    /* The native header report counts NAL bytes without the start code.
+     * Native consumers add exactly four bytes when walking the stream. */
+    *length = bytes - prefix;
+    g_byte_array_append(output, (const uint8_t *)"\0\0\0\1", 4);
+    g_byte_array_append(output, data + prefix, *length);
+    return true;
+}
+
+static bool w5p_hevc_headers(W5pCodec *codec, GByteArray *output,
+                            unsigned options, uint32_t lengths[4])
+{
+    if (!codec || !(options & 0x3c)) { return false; }
+    const uint8_t *data[4] = {0};
+    unsigned bytes[4] = {0};
+    /* Requested AUD is first, followed by VPS/SPS/PPS. The AUD describes
+     * the first intra picture. These are public Annex B syntax bytes;
+     * parameter sets themselves come from the selected host codec. */
+    static const uint8_t hevc_aud[] = {0, 0, 0, 1, 0x46, 1, 0x10};
+    static const uint8_t avc_aud[] = {0, 0, 0, 1, 9, 0x10};
+    data[0] = codec->codec_mode == 3 ? avc_aud : hevc_aud;
+    bytes[0] = codec->codec_mode == 3 ? sizeof(avc_aud) : sizeof(hevc_aud);
+    memset(lengths, 0, 4 * sizeof(*lengths));
+    if (codec->codec_mode == 3) {
+        x264_nal_t *nals = NULL; int count = 0;
+        if (x264_encoder_headers(codec->avc_encoder, &nals, &count) < 0 || count <= 0) { return false; }
+        for (int i = 0; i < count; i++) {
+            unsigned slot = nals[i].i_type == 7 ? 2 : nals[i].i_type == 8 ? 3 : 4;
+            if (slot < 4) { data[slot] = nals[i].p_payload; bytes[slot] = nals[i].i_payload; }
+        }
+    } else {
+        x265_nal *nals = NULL; uint32_t count = 0;
+        if (codec->api->encoder_headers(codec->encoder, &nals, &count) < 0 || !count) { return false; }
+        for (unsigned i = 0; i < count; i++) {
+            unsigned type = nals[i].type;
+            if (type >= 32 && type <= 34) {
+                data[type - 31] = nals[i].payload; bytes[type - 31] = nals[i].sizeBytes;
+            }
+        }
+    }
+    const unsigned masks[] = {0x20, 4, 8, 0x10};
+    for (unsigned slot = 0; slot < 4; slot++) {
+        if (!(options & masks[slot]) || (slot == 1 && codec->codec_mode == 3)) { continue; }
+        if (!data[slot] || !w5p_header_nal(output, data[slot], bytes[slot], &lengths[slot])) { return false; }
+    }
+    return output->len != 0;
+}
+
+static bool w5p_hevc_picture(W5pCodec *codec, uint8_t *planes[3], const unsigned strides[3],
+                            uint64_t pts, GByteArray *output, unsigned *nal_type)
+{
+    if (!codec || !planes[0] || !planes[1] || !planes[2]) { return false; }
+    if (codec->codec_mode == 3) {
+        x264_picture_t input, result;
+        x264_picture_init(&input); x264_picture_init(&result);
+        input.img.i_csp = X264_CSP_I420 | (codec->depth > 8 ? X264_CSP_HIGH_DEPTH : 0);
+        input.img.i_plane = 3; input.i_pts = pts;
+        for (unsigned i = 0; i < 3; i++) {
+            input.img.plane[i] = planes[i]; input.img.i_stride[i] = strides[i];
+        }
+        x264_nal_t *nals = NULL; int count = 0;
+        if (x264_encoder_encode(codec->avc_encoder, &nals, &count, &input, &result) <= 0 || count <= 0) {
+            return false;
+        }
+        *nal_type = nals[0].i_type;
+        for (int i = 0; i < count; i++) {
+            uint32_t length;
+            if (!w5p_header_nal(output, nals[i].p_payload, nals[i].i_payload, &length)) {
+                return false;
+            }
+            if (nals[i].i_type == NAL_SLICE || nals[i].i_type == NAL_SLICE_IDR) { *nal_type = nals[i].i_type; }
+        }
+        codec->frames++; return true;
+    }
+    x265_picture *input = codec->api->picture_alloc();
+    x265_picture *result = codec->api->picture_alloc();
+    if (!input || !result) {
+        if (input) { codec->api->picture_free(input); }
+        if (result) { codec->api->picture_free(result); }
+        return false;
+    }
+    codec->api->picture_init(codec->param, input);
+    codec->api->picture_init(codec->param, result);
+    input->bitDepth = codec->depth; input->pts = pts;
+    for (unsigned i = 0; i < 3; i++) {
+        input->planes[i] = planes[i]; input->stride[i] = strides[i];
+    }
+    x265_nal *nals = NULL; uint32_t count = 0;
+    int produced = codec->api->encoder_encode(codec->encoder, &nals, &count, input, result);
+    bool valid = produced == 1 && count != 0;
+    if (valid) {
+        *nal_type = nals[0].type;
+        for (unsigned i = 0; i < count; i++) {
+            uint32_t length;
+            if (!w5p_header_nal(output, nals[i].payload, nals[i].sizeBytes, &length)) {
+                valid = false; break;
+            }
+            if (nals[i].type < 32) { *nal_type = nals[i].type; }
+        }
+        if (valid) { codec->frames++; }
+    }
+    codec->api->picture_free(input); codec->api->picture_free(result);
+    return valid;
+}
diff --git a/hw/arm/nikon-z8-jpeg-decode-mmio.h b/hw/arm/nikon-z8-jpeg-decode-mmio.h
--- /dev/null
+++ b/hw/arm/nikon-z8-jpeg-decode-mmio.h
@@ -0,0 +1,274 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* WonderLantern z8-qemu 09aacd2: finite JPEG decode; adapted to local per-core encoder state. */
+#include "nikon-z8-jpegdec.h"
+
+static void z8_jdec_irq_update(NikonZ9State *s, unsigned b)
+{
+    qemu_irq line = s->engine15e2_jpeg_irq[b];
+    uint32_t pending = s->z8_jdec_pending[b];
+
+    pending |= s->engine15e2_jpeg_pending[b];
+    if (line) {
+        qemu_set_irq(line, !!(pending & s->engine15e2_config[b][0x484 / 4]));
+    }
+}
+
+static void z8_jdec_fail(NikonZ9State *s, unsigned b, const char *why)
+{
+    s->z8_jdec_phase[b] = 0;
+    s->z8_jdec_output_valid[b] = false;
+    s->z8_jdec_hold[b] = 0;
+    s->z8_jdec_core[b] = 0;
+    s->z8_jdec_pending[b] |= 0x20400000;
+    s->z8_jdec_errors++;
+    fprintf(stderr, "Z8_JPEG_DECODE core=%u: %s; error status\n", b, why);
+    z8_jdec_irq_update(s, b);
+}
+
+/* The input, read as it is: the blocks +0x458 counts and one more, for the
+ * tail a whole-block count leaves out. The playback job leaves +0x458 at 0
+ * (sub_40C0D4B8 writes 0 for a zero length: the core reads to the EOI);
+ * then up to 32 MiB of RAM from the start. Either way libjpeg stops at the
+ * EOI and the rest is unread. */
+static uint8_t *z8_jdec_input(NikonZ9State *s, unsigned b, size_t *len)
+{
+    const uint32_t *c = s->engine15e2_config[b];
+    uint64_t in = (uint64_t)c[0x440 / 4] << 4;
+    size_t n = c[0x458 / 4] ? ((size_t)c[0x458 / 4] + 1) * 512 : 32 * MiB;
+    size_t least = c[0x458 / 4] ? (size_t)c[0x458 / 4] * 512 : 64 * KiB;
+    uint8_t *buf;
+
+    if (n > 128 * MiB) {
+        return NULL;
+    }
+    while (!dma_ram_range(s, in, n)) {
+        n = c[0x458 / 4] ? n - 512 : n / 2;
+        if (n < least) {
+            return NULL;
+        }
+    }
+    buf = g_malloc(n);
+    if (address_space_read(&address_space_memory, in, MEMTXATTRS_UNSPECIFIED,
+                           buf, n) != MEMTX_OK) {
+        g_free(buf);
+        return NULL;
+    }
+    *len = n;
+    return buf;
+}
+
+static void z8_jdec_header(NikonZ9State *s, unsigned b)
+{
+    uint32_t *c = s->engine15e2_config[b];
+    unsigned hs = (c[0x400 / 4] >> 2) & 3, vs = (c[0x404 / 4] >> 2) & 3;
+    unsigned w, h, format;
+    size_t len;
+    uint8_t *in;
+    bool ok;
+
+    s->z8_jdec_start[b] = false;
+    in = z8_jdec_input(s, b, &len);
+    if (!in) {
+        fprintf(stderr, "Z8_JPEG_DECODE core=%u input %" PRIx64 ", %u blocks\n",
+                b, (uint64_t)c[0x440 / 4] << 4, c[0x458 / 4]);
+        z8_jdec_fail(s, b, "input outside RAM");
+        return;
+    }
+    ok = z8_jpegdec_info(in, len, &w, &h, &format);
+    g_free(in);
+    if (!ok) {
+        z8_jdec_fail(s, b, "not a baseline 4:2:2/4:2:0 JPEG");
+        return;
+    }
+    c[0] = (c[0] & ~7u) | format;
+    c[0x1c / 4] = (w + (1u << hs) - 1) >> hs;
+    c[0x18 / 4] = (h + (1u << vs) - 1) >> vs;
+    c[0x3c / 4] = 0;
+    s->z8_jdec_core[b] = 0;
+    s->z8_jdec_hold[b] = 1;
+    s->z8_jdec_phase[b] = 1;
+    s->z8_jdec_pending[b] |= 0x0a001000;
+    fprintf(stderr, "Z8_JPEG_DECODE core=%u header %ux%u format %u scale 1/%u x 1/%u"
+            " -> %ux%u\n", b, w, h, format, 1u << hs, 1u << vs,
+            c[0x1c / 4], c[0x18 / 4]);
+    z8_jdec_irq_update(s, b);
+}
+
+static void z8_jdec_run(NikonZ9State *s, unsigned b)
+{
+    uint32_t *c = s->engine15e2_config[b];
+    unsigned hs = (c[0x400 / 4] >> 2) & 3, vs = (c[0x404 / 4] >> 2) & 3;
+    unsigned yp = c[0x410 / 4], cp = c[0x414 / 4];
+    unsigned ow = c[0x418 / 4], oh = c[0x41c / 4];
+    unsigned x0 = c[0x420 / 4] ? c[0x424 / 4] : 0;
+    unsigned y0 = c[0x420 / 4] ? c[0x428 / 4] : 0;
+    unsigned format = c[0] & 7, dw, dh, crows;
+    uint64_t ya = (uint64_t)c[0x430 / 4] << 4, ca = (uint64_t)c[0x434 / 4] << 4;
+    uint8_t *in, *img, *yrow, *crow;
+    size_t len;
+
+    s->z8_jdec_go[b] = false;
+    s->z8_jdec_hold[b] = 0;
+    s->z8_jdec_output_valid[b] = false;
+    crows = format == 2 ? (oh + 1) / 2 : oh;
+    if (!ow || !oh || ow > 16384 || oh > 16384 || yp < ow || cp < ((ow + 1) & ~1u) ||
+        yp > 32768 || cp > 32768 || (format != 1 && format != 2) ||
+        !dma_ram_range(s, ya, (uint64_t)yp * (oh - 1) + ow) ||
+        !dma_ram_range(s, ca, (uint64_t)cp * (crows - 1) + ((ow + 1) & ~1u))) {
+        z8_jdec_fail(s, b, "output geometry outside RAM");
+        return;
+    }
+    uint64_t yn = (uint64_t)yp * (oh - 1) + ow;
+    uint64_t cn = (uint64_t)cp * (crows - 1) + ((ow + 1) & ~1u);
+    if (graphics_spans_overlap(ya, yn, ca, cn) ||
+        !nb_writable(&s->output_owner, (NBSpan){ya, yn}) ||
+        !nb_writable(&s->output_owner, (NBSpan){ca, cn})) {
+        z8_jdec_fail(s, b, "output overlaps owned RAM"); return;
+    }
+    in = z8_jdec_input(s, b, &len);
+    if (!in) {
+        z8_jdec_fail(s, b, "input outside RAM");
+        return;
+    }
+    img = z8_jpegdec_ycc(in, len, hs, vs, &dw, &dh);
+    g_free(in);
+    if (!img) {
+        z8_jdec_fail(s, b, "libjpeg refused the stream");
+        return;
+    }
+    yrow = g_malloc(ow);
+    crow = g_malloc((ow + 1) & ~1u);
+    bool written = true;
+    for (unsigned r = 0; written && r < oh; r++) {
+        const uint8_t *src = img + (size_t)MIN(y0 + r, dh - 1) * dw * 3;
+
+        for (unsigned x = 0; x < ow; x++) {
+            yrow[x] = src[(size_t)MIN(x0 + x, dw - 1) * 3];
+        }
+        written = address_space_write(&address_space_memory, ya + (uint64_t)r * yp,
+                            MEMTXATTRS_UNSPECIFIED, yrow, ow) == MEMTX_OK;
+        if (!written) { break; }
+        if (format == 2 && (r & 1)) {
+            continue;
+        }
+        for (unsigned x = 0; x < ow; x += 2) {
+            const uint8_t *p = src + (size_t)MIN(x0 + x, dw - 1) * 3;
+
+            crow[x] = p[1];
+            crow[x + 1] = p[2];
+        }
+        written = address_space_write(&address_space_memory,
+                            ca + (uint64_t)(format == 2 ? r / 2 : r) * cp,
+                            MEMTXATTRS_UNSPECIFIED, crow, (ow + 1) & ~1u) == MEMTX_OK;
+    }
+    g_free(yrow);
+    g_free(crow);
+    g_free(img);
+    if (!written) { z8_jdec_fail(s, b, "output DMA failed"); return; }
+    c[0x470 / 4] = oh;
+    s->z8_jdec_core[b] = 0x80000000;
+    s->z8_jdec_pending[b] |= 0x0800c000;
+    s->z8_jdec_phase[b] = 2;
+    s->z8_jdec_jobs++;
+    s->z8_jdec_output_valid[b] = true;
+    s->z8_jdec_output_epoch[b]++;
+    s->z8_jdec_y[b] = ya; s->z8_jdec_uv[b] = ca;
+    s->z8_jdec_width[b] = ow; s->z8_jdec_height[b] = oh;
+    s->z8_jdec_yp[b] = yp; s->z8_jdec_cp[b] = cp;
+    s->z8_jdec_format[b] = format;
+    fprintf(stderr, "Z8_JPEG_DECODE core=%u image %ux%u at (%u,%u) of %ux%u -> y=%"
+            PRIx64 "/%u c=%" PRIx64 "/%u format %u\n", b, ow, oh, x0, y0, dw, dh,
+            ya, yp, ca, cp, format);
+    z8_jdec_irq_update(s, b);
+}
+
+static bool z8_jdec_read(NikonZ9State *s, unsigned b, unsigned off,
+                          unsigned size, uint64_t *value)
+{
+    if (!s->z8_jdec_on || b > 1 || !s->z8_jdec_active[b]) {
+        return false;
+    }
+    if (size != 4 || (off & 3)) {
+        unknown_access(s, (b ? 0x15e21000 : 0x15e20000) + off, 0, size, false);
+        *value = 0;
+        return true;
+    }
+    switch (off) {
+    case 0x02c: *value = s->z8_jdec_core[b]; break;
+    case 0x030: case 0x034: case 0x488: *value = 0; break;
+    case 0x038: *value = s->z8_jdec_hold[b]; break;
+    case 0x480: *value = s->z8_jdec_pending[b]; break;
+    default: *value = s->engine15e2_config[b][off / 4]; break;
+    }
+    return true;
+}
+
+static bool z8_jdec_write(NikonZ9State *s, unsigned b, unsigned off,
+                           uint64_t value, unsigned size)
+{
+    uint32_t *c = s->engine15e2_config[b];
+
+    if (!s->z8_jdec_on || b > 1) {
+        return false;
+    }
+    if (off == 0) {
+        if (size != 4 || !(value & 8) || (value & ~0xffull)) {
+            s->z8_jdec_active[b] = false;      /* back to the encoder */
+            return false;
+        }
+        if (!s->z8_jdec_active[b]) {
+            s->z8_jdec_active[b] = true;
+            s->z8_jdec_phase[b] = 0;
+            s->z8_jdec_start[b] = s->z8_jdec_go[b] = false;
+            s->z8_jdec_pending[b] = s->z8_jdec_core[b] = s->z8_jdec_hold[b] = 0;
+        }
+        c[0] = value;
+        return true;
+    }
+    if (!s->z8_jdec_active[b]) {
+        return false;
+    }
+    if (size != 4 || (off & 3) || off >= 0x500) {
+        unknown_access(s, (b ? 0x15e21000 : 0x15e20000) + off, value, size, true);
+        return true;
+    }
+    switch (off) {
+    case 0x004:
+        if (value & 0x80000000) {               /* reset */
+            s->z8_jdec_output_valid[b] = false;
+            s->z8_jdec_phase[b] = 0;
+            s->z8_jdec_start[b] = s->z8_jdec_go[b] = false;
+            s->z8_jdec_hold[b] = s->z8_jdec_core[b] = 0;
+            c[1] = 0;
+            break;
+        }
+        if (value & 1) {
+            s->z8_jdec_output_valid[b] = false;
+            s->z8_jdec_start[b] = true;
+        }
+        if ((value & 2) && s->z8_jdec_phase[b] == 1) {
+            s->z8_jdec_go[b] = true;
+        }
+        c[1] = value & ~3u;
+        break;
+    case 0x02c:
+        s->z8_jdec_core[b] &= value;           /* the handler writes ~bits */
+        break;
+    case 0x480:
+        s->z8_jdec_pending[b] &= ~value;
+        break;
+    default:
+        c[off / 4] = value;
+        break;
+    }
+    if (s->z8_jdec_start[b] && s->z8_jdec_phase[b] != 1 &&
+        (c[0x404 / 4] & 0xc000) == 0x4000) {
+        z8_jdec_header(s, b);
+    }
+    if (s->z8_jdec_go[b] && s->z8_jdec_phase[b] == 1 &&
+        (c[0x400 / 4] & 0xc000) == 0x4000) {
+        z8_jdec_run(s, b);
+    }
+    z8_jdec_irq_update(s, b);
+    return true;
+}
