+static const uint16_t w5p_fio_offsets[] = {
+    0x88f0,0x88f4,0xfe10,0xfe14,0x8e10,0x8e14,0x9e10,0x9e14,
+    0xfe0c,0xfec0,0xfee0,0xfea0,0xfea4,0xfea8,0xfeac,0xff00,
+    0xfe64,0xfe6c
