@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <glib.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <inttypes.h>
+#include <assert.h>
+#include <string.h>
+#include <pthread.h>
+#include <unistd.h>
+#include <zlib.h>
+#define MiB (1024ULL*1024)
+#define QEMU_CLOCK_VIRTUAL 0
+#define QEMU_THREAD_JOINABLE 0
+#define MEMTX_OK 0
+#define MEMTXATTRS_UNSPECIFIED 0
+#define W5P_UNIT_TEST 1
+typedef uint64_t hwaddr;
+typedef pthread_mutex_t QemuMutex;
+typedef pthread_t QemuThread;
+typedef struct { int pending; } QEMUTimer;
+typedef int *qemu_irq;
+static uint64_t clock_ns;
+static int address_space_memory;
+static uint8_t ram[32*MiB];
+static const uint64_t ram_base=0xa00000000ULL;
+typedef struct NikonZ9State {
+    struct W5pState *w5p;
+    bool w5p_model,wave5_busy,w5p_host_codec_diagnostic;
+    uint32_t video_processing_global[4];
+} NikonZ9State;
+static bool dma_ram_range(NikonZ9State *s,uint64_t a,uint64_t n) { return n && a>=ram_base && a-ram_base<sizeof(ram) && n<=sizeof(ram)-(a-ram_base); }
+static bool raw_pipeline_address(NikonZ9State *s,uint64_t a,uint64_t n,uint64_t *p) { return false; }
+static bool graphics_spans_overlap(uint64_t a,uint64_t n,uint64_t b,uint64_t m) { return n && m && a<b+m && b<a+n; }
+static int address_space_read(void *s,uint64_t a,int attr,void *buf,size_t n) { if(!dma_ram_range(NULL,a,n))return 1;memcpy(buf,ram+a-ram_base,n);return 0; }
+static int address_space_write(void *s,uint64_t a,int attr,const void *buf,size_t n) { if(!dma_ram_range(NULL,a,n))return 1;memcpy(ram+a-ram_base,buf,n);return 0; }
+static void stl_le_p(void *p,uint32_t v) { v=GUINT32_TO_LE(v);memcpy(p,&v,4); }
+static void stw_le_p(void *p,uint16_t v) { v=GUINT16_TO_LE(v);memcpy(p,&v,2); }
+static uint16_t lduw_le_p(const void *p) { uint16_t v;memcpy(&v,p,2);return GUINT16_FROM_LE(v); }
+static uint16_t lduw_be_p(const void *p) { uint16_t v;memcpy(&v,p,2);return GUINT16_FROM_BE(v); }
+static uint32_t ldl_le_p(const void *p) { uint32_t v;memcpy(&v,p,4);return GUINT32_FROM_LE(v); }
+static uint32_t ldl_be_p(const void *p) { uint32_t v;memcpy(&v,p,4);return GUINT32_FROM_BE(v); }
+static void qemu_set_irq(qemu_irq irq,int level) { *irq=level; }
+static uint64_t qemu_clock_get_ns(int c) { return clock_ns; }
+static void timer_mod(QEMUTimer *t,uint64_t n) { t->pending=1; }
+static void qemu_mutex_lock(QemuMutex *m) { pthread_mutex_lock(m); }
+static void qemu_mutex_unlock(QemuMutex *m) { pthread_mutex_unlock(m); }
+static void qemu_thread_create(QemuThread *t,const char *name,void *(*fn)(void *),void *p,int mode) { assert(!pthread_create(t,NULL,fn,p)); }
+static void qemu_thread_join(QemuThread *t) { assert(!pthread_join(*t,NULL)); }
+#include "nikon-z8-wave5-port.h"
+static NikonZ9State s;
+static W5pState w;
+static QEMUTimer timer;
+static int irq;
+static unsigned mode;
+static void wr(unsigned o,uint32_t v) { uint64_t x=v;assert(w5p_access(&s,W5P_BASE+o,&x,4,true)); }
+static uint32_t rd(unsigned o) { uint64_t x=0;assert(w5p_access(&s,W5P_BASE+o,&x,4,false));return x; }
+static bool cmd(unsigned c,bool boot) { wr(0x100,c);wr(0x70,1);wr(boot?0x6c:0x38,1);return rd(0x108)!=0; }
+static void ack(void) { wr(0x34,rd(0x4c));wr(0x3c,1);assert(!irq && !w.pending && !(s.video_processing_global[3]&1)); }
+static void query(void) { wr(0x104,2);assert(cmd(0x4000,false));assert(rd(0x1dc)==1); }
+static void wait_job(void) {
+    for(int n=0;n<10000 && w.job;n++) { usleep(1000);clock_ns+=1000000;w5p_tick(&w); }
+    assert(!w.job && !w.busy && !s.wave5_busy);
+}
+static void source(unsigned frame) {
+    for(unsigned y=0;y<64;y++)for(unsigned x=0;x<96;x++)ram[0x40000+y*96+x]=(x*2+y+frame*3)%220+16;
+    memset(ram+0x42000,100+frame,96*32);
+    wr(0x118,0x40100000);wr(0x11c,1*MiB);wr(0x128,4);
+    wr(0x144,frame);wr(0x148,0x40040000);wr(0x14c,0x40042000);wr(0x150,0);
+    wr(0x154,(96<<16)|96);wr(0x158,2);wr(0x164,0x23);
+}
+static void setup(unsigned m) {
+    mode=m;memset(&s,0,sizeof(s));memset(&w,0,sizeof(w));memset(ram,0,sizeof(ram));
+    s.w5p=&w;s.w5p_model=true;s.w5p_host_codec_diagnostic=true;w.board=&s;w.irq=&irq;w.timer=&timer;
+    pthread_mutex_init(&w.lock,NULL);w.external_reset_held=0x7f0000;
+    assert(!cmd(8,false) && rd(0x10c)==0x100); /* held reset */
+    for(unsigned n=16;n<=22;n++)assert(w5p_external_reset(&s,0x0d154248,1u<<n));
+    wr(0x110,0x40000000);wr(0x114,4096);wr(0x11c,0x40010000);wr(0x120,4096);
+    assert(!cmd(1,true)); /* zero microcode */
+    ram[0]=0xa5;assert(cmd(1,true));assert(w.booted && rd(4)==4);
+    wr(0x48,0);wr(0x110,mode<<16);wr(0x114,0x40020000);wr(0x118,4096);wr(0x124,0);
+    assert(cmd(8,false));assert(!irq && rd(0x4c)==8);wr(0x48,0xffffffff);assert(irq);ack();
+    assert(!cmd(8,false)); /* duplicate */
+    wr(0x104,0);wr(0x11c,(64<<16)|95);wr(0x124,(8<<14)|(mode==1?((153<<3)|(1<<12)):0));wr(0x150,30);wr(0x174,0);wr(0x178,0);
+    assert(!cmd(0x200,false)); /* odd width */
+    wr(0x11c,(64<<16)|96);wr(0x130,15<<(mode==3?17:16));
+    assert(cmd(0x200,false));assert(irq && rd(0x1fc)==1);ack();query();
+    wr(0x118,0x40100000);wr(0x11c,1*MiB);wr(0x164,0x3c);
+    assert(!cmd(0x100,false)); /* no frame registration */
+    assert(cmd(0x80,false));assert(w.instance[0].buffers);
+}
+static void run(unsigned m,const char *path) {
+    setup(m);FILE *f=fopen(path,"wb");assert(f);
+    wr(0x118,0x40100000);wr(0x11c,1*MiB);wr(0x128,4);wr(0x164,0x3c);
+    assert(cmd(0x100,false));assert(irq);ack();query();
+    unsigned bytes=rd(0x14c);assert(bytes>20);assert(fwrite(ram+0x100000,1,bytes,f)==bytes);
+    assert(ldl_le_p(ram+0x20100)>0); /* AUD report */
+    source(0);wr(0x154,1);assert(!cmd(0x100,false)); /* bad stride */
+    source(0);wr(0x14c,0x40040000);assert(!cmd(0x100,false)); /* overlapping source */
+    source(0);wr(0x118,0x40020000);assert(!cmd(0x100,false)); /* work overlap */
+    source(0);wr(0x158,7);assert(!cmd(0x100,false)); /* bad format */
+    source(0);wr(0x148,0x5fffffff);assert(!cmd(0x100,false)); /* invalid span */
+    for(unsigned n=0;n<30;n++) {
+        source(n);cmd(0x100,false);assert(w.busy);
+        wr(0x50,1);assert(w.busy && w.job); /* in-flight reset must not free worker */
+        assert(!w5p_external_reset(&s,0x0d154348,0x7f0000));
+        wait_job();assert(rd(0x108)==1 && irq && rd(0x1e8)==1);
+        assert(!cmd(0x20,false)); /* unconsumed result */
+        ack();query();bytes=rd(0x14c);assert(bytes>0);
+        assert(rd(0x154)==n);assert(rd(0x124)==((n%15)==0?0:1));
+        assert(fwrite(ram+0x100000,1,bytes,f)==bytes);
+    }
+    fclose(f);
+    /* Output overflow is an error with no partial RAM write. */
+    source(31);wr(0x11c,1);ram[0x100000]=0x5a;cmd(0x100,false);wait_job();
+    assert(rd(0x108)==0 && rd(0x10c)==0x100 && ram[0x100000]==0x5a && !irq);
+    source(32);wr(0x164,0xe3);cmd(0x100,false);wait_job();assert(w.instance[0].native_end_written);
+    ack();query();assert(rd(0x14c)>0);
+    source(33);wr(0x144,UINT32_MAX);assert(cmd(0x100,false));ack();query();
+    assert(rd(0x14c)==0 && rd(0x12c)==UINT32_MAX && w.instance[0].native_drained);
+    source(34);assert(!cmd(0x100,false));
+    assert(cmd(0x20,false));assert(!w.instances);
+    assert(cmd(4,false));assert(w.sleeping);assert(!cmd(8,false));assert(cmd(2,false));
+    wr(0x24,0x100);wr(0x20,0x188f0);assert(w5p_bus_stopped(&w));assert(!cmd(2,false)); /* FIO bus stopped */
+    wr(0x24,0);wr(0x20,0x188f0);assert(!w5p_bus_stopped(&w));assert(cmd(2,false));
+    wr(0x50,1);assert(!w.booted && !rd(0x54));
+    assert(w5p_external_reset(&s,0x0d154348,0x7f0000));assert(w.external_reset_held==0x7f0000 && !irq);
+    uint64_t v=0;s.w5p_model=false;assert(!w5p_access(&s,W5P_BASE,&v,4,false));
+    pthread_mutex_destroy(&w.lock);
+    printf("PASS codec=%u 30 frames GOP15, IRQ, DMA, lifecycle and error paths\n",m);
+}
+int main(int argc,char **argv) { assert(argc==3);run(1,argv[1]);run(3,argv[2]);return 0; }
