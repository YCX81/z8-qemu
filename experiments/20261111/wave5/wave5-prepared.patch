@@ -0,0 +1,35 @@
+Wave5 encoder port (emulation only, November 2026)
+
+Based on locally supplied WonderLantern/z8-qemu, z8-head snapshot 5374744:
+- qemu/nikon-z8-wave5.h -> hw/arm/nikon-z8-wave5-port.h
+- qemu/nikon-wave5-codec.h -> hw/arm/nikon-w5p-codec.h
+- qemu/nikon-z8-lab.c IRQ120/QOM/reset wiring -> hw/arm/nikon-z9-lab.c
+
+Relevant upstream changes:
+d40a275afdda949b594a801e2b549fff18c6caf4 (IRQ120 binding)
+4189ae8aa6d332b52de92273b467191d6f9ec65d (HEVC tier/level)
+34503f3e2cea4d39886c53e94f010c3b9fa94548 (native movie integration)
+a440750adca2dcc28eec74d1c451d374c7966590 (movie preparation)
+566d75a32a560cd0ede3208cf15f8814b1fb7305 (movie frame notification)
+
+Copyright (C) 2026 RdWing and original contributors.
+SPDX-License-Identifier: GPL-2.0-or-later
+Original source notices are retained. Namespaces and board types were adapted
+for NikonZ9State/QEMU 10.2.4, preserving the existing local audio+v2 backend.
+The checked WLYV source adapter is from that local baseline's
+hw/arm/nikon-z8-yuv-wave5.h; its GPL notice is retained.
+Local changes add a default-off selector, bounded handled MMIO errors, initial
+reset ownership, command/IRQ logging, joinable worker teardown, IRQ mask reset, native terminal-frame/drain handling,
+and NR reset ownership protection.
+
+The optional playback decoder added by 76235efc2db04972ccca2d5e51bf3ef4d10fd91a
+(nikon-wave5-decode.h) is NOT part of this encoder port. The upstream
+video_main compact surface producer is replaced by this base's checked WLYV
+RAM adapter. The existing local movie clock/reset/producer implementations
+remain in use; the commits above do not imply all their files were copied.
+
+QEMU, x264, x265, and GLib retain their respective licenses. No Nikon firmware
+or microcode is distributed by wave5.patch; microcode bytes supplied by the
+user are checked/hashed as DMA input, never interpreted or executed here.
+The 0x5210 device profile, host encoder, latency, and reference storage are
+explicit emulation conventions, not a measured implementation of Nikon silicon.
diff --git a/docs/wave5-client.md b/docs/wave5-client.md
--- /dev/null
+++ b/docs/wave5-client.md
@@ -0,0 +1,73 @@
+# Wave5 emulation client contract
+
+This describes `wave5-upstream-model=on`, not a silicon specification. The
+property is immutable after machine realization and defaults off. It selects
+an independent upstream encoder backend at `0x16010000`, with IRQ INTID120;
+`wave5-upstream-state` exposes counters and register snapshots. The older
+`wave5-*` properties remain available for regression. Do not mix clients of
+the two backends in one run. No Nikon microcode is executed.
+
+All offsets below are 32-bit, aligned, relative to that MMIO base. For every
+command, write its arguments, `+100=command`, `+70=1`, then `+38=1` (host
+interrupt); INIT uses `+6c=1` (core start). Poll `+70` until zero, then inspect
+`+108` (accepted/success=1) and `+10c` (failure reason). Register argument and
+result windows overlap: save results before preparing the next command.
+Only one encode job is in flight globally. Four instance IDs 0..3 are accepted.
+For instance commands `+110=(codec_mode<<16)|instance`; HEVC=1, AVC=3.
+
+| Phase | Command / fields | Completion |
+|---|---|---|
+| Reset release | Release bank8 bits16..22 at `0x0d154248`; reset assert is `0x0d154348`. The model initially holds all seven. The existing board separately handles bits23/24 (native reset IDs0x4a/4b). | Any held bit blocks commands. Assert requires no job, pending reason or instance; the complete bundle clears core/FIO state. |
+| INIT | `1`, core-start. `+110=code_bus`, `+114=code_bytes` (nonzero, 4KiB multiple, ≤4MiB), `+11c=temp_bus`, `+120=temp_bytes`. Code/temp must map and not overlap; code cannot be all zero. | `CUR_PC +4=4` is a modeled service marker, not executed vendor code. Code bytes/CRC are recorded. No IRQ. |
+| CREATE | `8`; `+114=work_bus`, `+118=work_bytes` (0x110..4MiB). `+124 bit9` selects stream ring; then `+11c=ring_bus`, `+120=ring_bytes` (≤256MiB). Work cannot overlap code or ring. | reason bit3; native mask may leave it polling-only. |
+| SET_PARAM | `0x200`, `+104=0`; `+11c=(height<<16)|width`, `+124 bits14..17=depth` (8/10), HEVC level bits3..11, tier bit12; `+130 high16=HEVC GOP`; `+178=fps_n`, `+174=fps_d` or `+150=integer fps`. AVC VUI denominator is doubled. | reason bit9, instance bitmap `+1fc`; QUERY_RESULT gives minimum 2 source/reference buffers and two 4096-byte virtual management sizes. |
+| SET_FB | `0x80`, after successful SET_PARAM. | No IRQ. Upstream encoder model retains the command-register writes and marks buffers registered; it does **not** implement physical FBC/reference storage or validate every encoded reference descriptor. x264/x265 owns references. Real clients must use native allocation/registration. |
+| Headers | `0x100`; `+118=output_bus`, `+11c=capacity`, `+128 bit2=report`; `+164=0x3c` requests AUD/VPS/SPS/PPS (AVC omits VPS). | reason bit8, `+1e8` instance bit, `+1e0=1`. Exact four-byte Annex-B prefixes; header NAL lengths excluding prefixes at work+0x100. |
+| Picture | `0x100`; output as above; `+144=source_index`, `+148=Y`, `+14c=UV`, `+150=V` for planar; `+154=(Y_stride<<16)|C_stride`; `+158=2` is linear 8-bit NV12; `+164=0x23` is picture+AUD. | Real source RAM is copied, host codec runs on a worker, result bytes DMA to guest output. Timer checks every 1ms virtual time. IRQ bit8 only after success. |
+| QUERY_RESULT | `0x4000`, `+104=2`; acknowledge reason before reusing source/result. | `+1dc=1`; `+114/+118=start/end bus`, `+14c=byte_count`, `+154=consumed source`, `+12c=recon index` (header=-3, drain=-1), `+124=I/P`, `+1a8=work_bus` if report. Result lease is consumed. No new IRQ. |
+| Finish | Native final picture option `0xe3` appends EOS/EOB; then source `0xffffffff` drains once with zero output. Standalone no-source without a prior terminal picture emits EOS. `0x20` destroys; `0x10` closes host codec without destroying instance. | Requires prior result/IRQ consumption. No IRQ for destroy. Then assert reset bundle. |
+
+**IRQ:** mask `+48`; reason mirrored at `+30/+4c`, `+44=(pending!=0)`.
+IRQ120 and the shared video-controller bit0 assert only when `pending & mask`.
+Write `+34=reason` (W1C), then `+3c=1`. Native ISR also retires the per-instance
+bitmaps by read/modify/write. SET_PARAM uses `+1fc`; encode uses `+1e8`.
+Masked completions remain pending until acknowledged; queries do not silently
+clear the completion reason.
+
+**Addressing:** nonzero FIO `0xfec0` supplies the DMA high32 bits for code,
+source, work and stream. FIO data is `+24`; write `+20=0x10000|address`, or
+`+20=address` to read; bit31 signals completion. With no high word, virtual bus
+`0x40000000..0x5fffffff` maps to work RAM starting `0xa00000000`; other board
+mappings must pass the actual RAM range check. This aperture is model-defined.
+The local native movie producer additionally uses its checked WLYV compressed
+RAM packets and ownership records; those packets are not a hardware format.
+The model never reads a host preview image as a substitute for guest planes.
+
+**Formats:** the upstream direct snapshot accepts 4:2:0 planar layout0/1,
+interleaved layout2 (NV12) / layout3 (NV21), 8-bit byte samples, and 10-bit
+16-bit or 3-in-32 packing (LSB/MSB justified). Endian codes0/15 use little-endian
+storage; code12 reverses 32-bit lanes. Packing/layout/stride mismatch,
+unmapped spans, plane overlap, and source/output/work overlap fail. NV16 4:2:2,
+Nikon tiled/FBC input and arbitrary ISP layouts are not accepted as linear NV12.
+The inherited WLYV native-source adapter is limited to 8-bit NV12/endian0/15.
+
+**Gating and bounds:** FIO bus-stop registers `88f0,fe10,8e10,9e10` inhibit
+commands except SLEEP=4; WAKE=2 restores a sleeping core only after bus release.
+Synchronous reset `+50` acknowledges at `+54=0`, clears instances/IRQ state,
+and refuses outstanding jobs/results. This models the observed handshake;
+physical PLL/power sequencing and exact clock rates are not implemented by
+the encoder. The existing board handles native power/clock accesses.
+Widths/heights must be even and ≤8192; source copy ≤128MiB, each DMA span
+≤256MiB, output ≤64MiB in non-ring mode. Ring writes append only; no wrap or
+reader recycling is implemented. Source/work/output reservations must stay
+owned until completion. Input format is copied before the host worker starts.
+
+**Errors:** rejected aligned/unaligned/unknown MMIO in this aperture is handled,
+not passed to QEMU's fatal unknown-access path. Reads return zero on rejection;
+when idle, `+70=0,+108=0,+10c=0x100`. A rejected write during an active job
+preserves that job. Encoder failure/output overflow writes no partial bitstream,
+clears busy and sets failure status; it does not signal a successful IRQ.
+Clients must check status with a bounded wait, not wait indefinitely for IRQ.
+Reset cannot cancel a running worker. Teardown joins the worker before freeing
+its buffers/codec. Rates, quality, latency, minimum reference counts and error
+codes here are model conventions, not measured EXPEED/Wave5 behavior.
diff --git a/hw/arm/nikon-w5p-codec.h b/hw/arm/nikon-w5p-codec.h
--- /dev/null
+++ b/hw/arm/nikon-w5p-codec.h
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Authored functional HEVC/AVC backend. Uses installed public x265/x264 APIs;
+ * no Nikon firmware, microcode or compression implementation is included.
+ * Input planes are immutable actual DMA snapshots, never preview upshifts.
+ */
+#include <x265.h>
+#include <x264.h>
+
+typedef struct W5pCodec {
+    const x265_api *api;
+    x265_param *param;
+    x265_encoder *encoder;
+    x264_param_t *avc_param;
+    x264_t *avc_encoder;
+    unsigned codec_mode; /* Explicit Wave5 convention: 1 HEVC, 3 AVC. */
+    unsigned width, height, depth;
+    uint64_t frames;
+} W5pCodec;
+
+static void w5p_hevc_close(W5pCodec *codec)
+{
+    if (!codec) { return; }
+    if (codec->avc_encoder) { x264_encoder_close(codec->avc_encoder); }
+    if (codec->avc_param) {
+        x264_param_cleanup(codec->avc_param);
+        g_free(codec->avc_param);
+    }
+    if (codec->encoder) { codec->api->encoder_close(codec->encoder); }
+    if (codec->param) { codec->api->param_free(codec->param); }
+    g_free(codec);
+}
+
+static W5pCodec *w5p_hevc_open(unsigned width, unsigned height, unsigned depth,
+                               unsigned fps_n, unsigned fps_d, bool lossless,
+                               unsigned keyframe_period, unsigned level, bool high_tier)
+{
+    if (!width || !height || (width | height) & 1 || width > 8192 || height > 8192 ||
+        (depth != 8 && depth != 10) || !fps_n || !fps_d ||
+        (level && level != 30 && level != 60 && level != 63 && level != 90 &&
+         level != 93 && level != 120 && level != 123 && level != 150 &&
+         level != 153 && level != 156 && level != 180 && level != 183 && level != 186) ||
+        (high_tier && level < 120)) { return NULL; }
+    const x265_api *api = x265_api_get(depth);
+    if (!api || (unsigned)api->bit_depth != depth || api->sizeof_param != sizeof(x265_param) ||
+        api->sizeof_picture != sizeof(x265_picture)) { return NULL; }
+    W5pCodec *codec = g_new0(W5pCodec, 1);
+    codec->api = api;
+    codec->param = api->param_alloc();
+    if (!codec->param || api->param_default_preset(codec->param, "ultrafast", "zerolatency") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    x265_param *p = codec->param;
+    p->sourceWidth = width; p->sourceHeight = height;
+    p->internalCsp = X265_CSP_I420; p->internalBitDepth = depth;
+    p->fpsNum = fps_n; p->fpsDenom = fps_d;
+    /* Wave5/HEVC uses general_level_idc (three times level * 10).
+     * Preserve the requested tier in actual VPS/SPS and muxed hvcC. */
+    p->levelIdc = level / 3; p->bHighTier = high_tier;
+    p->frameNumThreads = 1;
+    p->bframes = 0; p->lookaheadDepth = 0;
+    p->bRepeatHeaders = 0; p->bAnnexB = 1;
+    /* Native movie packets retain the advertised AUD length on every
+     * access unit. Omitting it lets the mux overwrite VCL bytes at +7. */
+    p->bEnableAccessUnitDelimiters = 1;
+    if (keyframe_period) {
+        p->keyframeMax = keyframe_period; p->keyframeMin = 1;
+        p->scenecutThreshold = 0; p->bOpenGOP = 0;
+    }
+    p->bEnableWavefront = 0; p->bEnablePsnr = 0; p->bEnableSsim = 0;
+    p->logLevel = X265_LOG_ERROR;
+    p->bLossless = lossless;
+    p->rc.rfConstant = 18;
+    if (api->param_parse(p, "pools", "none") < 0 ||
+        api->param_apply_profile(p, depth == 10 ? "main10" : "main") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    codec->encoder = api->encoder_open(p);
+    if (!codec->encoder) { w5p_hevc_close(codec); return NULL; }
+    codec->width = width; codec->height = height; codec->depth = depth; codec->codec_mode = 1;
+    return codec;
+}
+
+static W5pCodec *w5p_video_open(unsigned mode, unsigned width, unsigned height, unsigned depth,
+                                unsigned fps_n, unsigned fps_d, bool lossless,
+                                const unsigned crop[4], unsigned keyframe_period,
+                                unsigned level, bool high_tier)
+{
+    if (mode == 1) { return w5p_hevc_open(width, height, depth, fps_n, fps_d, lossless, keyframe_period, level, high_tier); }
+    if (mode != 3 || !width || !height || (width | height) & 1 ||
+        width > 8192 || height > 8192 || (depth != 8 && depth != 10) || !fps_n || !fps_d) {
+        return NULL;
+    }
+    W5pCodec *codec = g_new0(W5pCodec, 1);
+    codec->avc_param = g_new0(x264_param_t, 1);
+    x264_param_t *p = codec->avc_param;
+    if (x264_param_default_preset(p, "ultrafast", "zerolatency") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    p->i_width = width; p->i_height = height; p->i_bitdepth = depth;
+    p->i_csp = X264_CSP_I420 | (depth > 8 ? X264_CSP_HIGH_DEPTH : 0);
+    /* Keep the complete coded DMA surface. SPS cropping controls the
+     * displayed rectangle, including each 4:2:0 chroma edge. */
+    p->crop_rect.i_left = crop[0]; p->crop_rect.i_top = crop[1];
+    p->crop_rect.i_right = crop[2]; p->crop_rect.i_bottom = crop[3];
+    p->i_fps_num = fps_n; p->i_fps_den = fps_d;
+    p->i_timebase_num = fps_d; p->i_timebase_den = fps_n;
+    p->i_threads = 1; p->i_lookahead_threads = 1;
+    p->i_bframe = 0; p->rc.i_lookahead = 0; p->b_vfr_input = 0;
+    p->b_repeat_headers = 0; p->b_annexb = 1; p->b_aud = 1;
+    p->i_log_level = X264_LOG_ERROR;
+    if (keyframe_period) {
+        p->i_keyint_max = keyframe_period; p->i_keyint_min = 1;
+        p->i_scenecut_threshold = 0; p->b_open_gop = 0;
+    }
+    if (lossless) { p->rc.i_rc_method = X264_RC_CQP; p->rc.i_qp_constant = 0; }
+    else { p->rc.i_rc_method = X264_RC_CRF; p->rc.f_rf_constant = 18; }
+    if (x264_param_apply_profile(p, lossless ? "high444" : depth == 10 ? "high10" : "high") < 0) {
+        w5p_hevc_close(codec); return NULL;
+    }
+    codec->avc_encoder = x264_encoder_open(p);
+    if (!codec->avc_encoder) { w5p_hevc_close(codec); return NULL; }
+    codec->width = width; codec->height = height; codec->depth = depth; codec->codec_mode = mode;
+    return codec;
+}
+
+static bool w5p_header_nal(GByteArray *output, const uint8_t *data,
+                          unsigned bytes, uint32_t *length)
+{
+    unsigned prefix = bytes >= 4 && !memcmp(data, "\0\0\0\1", 4) ? 4 :
+                      bytes >= 3 && !memcmp(data, "\0\0\1", 3) ? 3 : 0;
+    if (!prefix || bytes <= prefix) { return false; }
+    /* The native header report counts NAL bytes without the start code.
+     * Native consumers add exactly four bytes when walking the stream. */
+    *length = bytes - prefix;
+    g_byte_array_append(output, (const uint8_t *)"\0\0\0\1", 4);
+    g_byte_array_append(output, data + prefix, *length);
+    return true;
+}
+
+static bool w5p_hevc_headers(W5pCodec *codec, GByteArray *output,
+                            unsigned options, uint32_t lengths[4])
+{
+    if (!codec || !(options & 0x3c)) { return false; }
+    const uint8_t *data[4] = {0};
+    unsigned bytes[4] = {0};
+    /* Requested AUD is first, followed by VPS/SPS/PPS. The AUD describes
+     * the first intra picture. These are public Annex B syntax bytes;
+     * parameter sets themselves come from the selected host codec. */
+    static const uint8_t hevc_aud[] = {0, 0, 0, 1, 0x46, 1, 0x10};
+    static const uint8_t avc_aud[] = {0, 0, 0, 1, 9, 0x10};
+    data[0] = codec->codec_mode == 3 ? avc_aud : hevc_aud;
+    bytes[0] = codec->codec_mode == 3 ? sizeof(avc_aud) : sizeof(hevc_aud);
+    memset(lengths, 0, 4 * sizeof(*lengths));
+    if (codec->codec_mode == 3) {
+        x264_nal_t *nals = NULL; int count = 0;
+        if (x264_encoder_headers(codec->avc_encoder, &nals, &count) < 0 || count <= 0) { return false; }
+        for (int i = 0; i < count; i++) {
+            unsigned slot = nals[i].i_type == 7 ? 2 : nals[i].i_type == 8 ? 3 : 4;
+            if (slot < 4) { data[slot] = nals[i].p_payload; bytes[slot] = nals[i].i_payload; }
+        }
+    } else {
+        x265_nal *nals = NULL; uint32_t count = 0;
+        if (codec->api->encoder_headers(codec->encoder, &nals, &count) < 0 || !count) { return false; }
+        for (unsigned i = 0; i < count; i++) {
+            unsigned type = nals[i].type;
+            if (type >= 32 && type <= 34) {
+                data[type - 31] = nals[i].payload; bytes[type - 31] = nals[i].sizeBytes;
+            }
+        }
+    }
+    const unsigned masks[] = {0x20, 4, 8, 0x10};
+    for (unsigned slot = 0; slot < 4; slot++) {
+        if (!(options & masks[slot]) || (slot == 1 && codec->codec_mode == 3)) { continue; }
+        if (!data[slot] || !w5p_header_nal(output, data[slot], bytes[slot], &lengths[slot])) { return false; }
+    }
+    return output->len != 0;
+}
+
+static bool w5p_hevc_picture(W5pCodec *codec, uint8_t *planes[3], const unsigned strides[3],
+                            uint64_t pts, GByteArray *output, unsigned *nal_type)
+{
+    if (!codec || !planes[0] || !planes[1] || !planes[2]) { return false; }
+    if (codec->codec_mode == 3) {
+        x264_picture_t input, result;
+        x264_picture_init(&input); x264_picture_init(&result);
+        input.img.i_csp = X264_CSP_I420 | (codec->depth > 8 ? X264_CSP_HIGH_DEPTH : 0);
+        input.img.i_plane = 3; input.i_pts = pts;
+        for (unsigned i = 0; i < 3; i++) {
+            input.img.plane[i] = planes[i]; input.img.i_stride[i] = strides[i];
+        }
+        x264_nal_t *nals = NULL; int count = 0;
+        if (x264_encoder_encode(codec->avc_encoder, &nals, &count, &input, &result) <= 0 || count <= 0) {
+            return false;
+        }
+        *nal_type = nals[0].i_type;
+        for (int i = 0; i < count; i++) {
+            uint32_t length;
+            if (!w5p_header_nal(output, nals[i].p_payload, nals[i].i_payload, &length)) {
+                return false;
+            }
+            if (nals[i].i_type == NAL_SLICE || nals[i].i_type == NAL_SLICE_IDR) { *nal_type = nals[i].i_type; }
+        }
+        codec->frames++; return true;
+    }
+    x265_picture *input = codec->api->picture_alloc();
+    x265_picture *result = codec->api->picture_alloc();
+    if (!input || !result) {
+        if (input) { codec->api->picture_free(input); }
+        if (result) { codec->api->picture_free(result); }
+        return false;
+    }
+    codec->api->picture_init(codec->param, input);
+    codec->api->picture_init(codec->param, result);
+    input->bitDepth = codec->depth; input->pts = pts;
+    for (unsigned i = 0; i < 3; i++) {
+        input->planes[i] = planes[i]; input->stride[i] = strides[i];
+    }
+    x265_nal *nals = NULL; uint32_t count = 0;
+    int produced = codec->api->encoder_encode(codec->encoder, &nals, &count, input, result);
+    bool valid = produced == 1 && count != 0;
+    if (valid) {
+        *nal_type = nals[0].type;
+        for (unsigned i = 0; i < count; i++) {
+            uint32_t length;
+            if (!w5p_header_nal(output, nals[i].payload, nals[i].sizeBytes, &length)) {
+                valid = false; break;
+            }
+            if (nals[i].type < 32) { *nal_type = nals[i].type; }
+        }
+        if (valid) { codec->frames++; }
+    }
+    codec->api->picture_free(input); codec->api->picture_free(result);
+    return valid;
+}
