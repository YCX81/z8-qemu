@@ -0,0 +1,20 @@
+from pathlib import Path
+import subprocess,json,os
+D=Path(__file__).resolve().parent;E=D.parent/'evidence';S=Path(os.environ.get('NIKON_QEMU_SOURCE','/path/to/user/.local/share/nikon-z8-qemu/qemu-wave5/src'));R=S.parent
+E.mkdir(parents=True,exist_ok=True)
+E.mkdir(parents=True,exist_ok=True)
+flags=subprocess.check_output(['pkg-config','--cflags','--libs','glib-2.0','x265','x264'],text=True).split()
+subprocess.run(['cc','-std=gnu11','-g','-fsanitize=address,undefined','-I'+str(D/'include'),'-I'+str(S/'hw/arm'),str(D/'wave5.c'),'-o',str(R/'test-wave5'),*flags,'-pthread','-lz'],check=True)
+env=os.environ.copy();env['ASAN_OPTIONS']='detect_leaks=0'
+subprocess.run([str(R/'test-wave5'),str(E/'30.hevc'),str(E/'30.h264')],check=True,env=env)
+results=[]
+for name in ['30.hevc','30.h264']:
+    p=E/name
+    subprocess.run(['ffmpeg','-v','error','-xerror','-i',str(p),'-f','null','-'],check=True)
+    d=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_frames','-of','json',str(p)]))
+    assert len(d['frames'])==30
+    assert [i for i,f in enumerate(d['frames']) if f['key_frame']]==[0,15]
+    subprocess.run(['ffmpeg','-v','error','-xerror','-i',str(p),'-frames:v','1','-f','null','-'],check=True)
+    results.append(dict(file=name,streams=d['streams'],frames=len(d['frames']),key_frames=[0,15],decode_exit=0))
+(E/'unit-media.json').write_text(json.dumps(results,indent=2)+'\n')
+print('PASS ffmpeg HEVC/AVC first AU + 30-frame decode and GOP15')
