+/* Independent end-of-scope counters. Reading does not emit an event, drain
+ * I/O, reset a counter or change guest-visible state. Collect while paused and
+ * compare before/after snapshots if backend work may still complete. */
+static char *nvme_get_audit_state(Object *obj, Error **errp)
+{
+    NvmeCtrl *n = NVME(obj);
+
+    return g_strdup_printf("{\"schema\":1,\"instance\":%" PRIu64
+        ",\"last_request_id\":%" PRIu64 ",\"last_event_seq\":%" PRIu64
+        ",\"virtual_ns\":%" PRId64 "}",
+        n->audit_instance, qatomic_read(&n->audit_next_request),
+        qatomic_read(&n->audit_next_event), qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
