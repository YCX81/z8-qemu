--- a/hw/pci-host/designware.c
+++ b/hw/pci-host/designware.c
@@ -277,2 +277,5 @@
-    const uint64_t size   = (uint64_t)viewport->limit - base + 1;
-    const bool enabled    = viewport->cr[1] & DESIGNWARE_PCIE_ATU_ENABLE;
+    /* The limit register is the low32 bits of the same base-high window.
+     * Keep windows above4GiB bounded instead of unsigned subtraction wrap. */
+    const uint64_t limit = (base & ~UINT64_C(0xffffffff)) | viewport->limit;
+    const uint64_t size = limit >= base ? limit - base + 1 : 0;
+    const bool enabled = size && (viewport->cr[1] & DESIGNWARE_PCIE_ATU_ENABLE);
