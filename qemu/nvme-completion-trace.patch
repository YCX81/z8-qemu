+/* Opt-in trace output; these counters never affect NVMe control or status.
+ * Explicit virtual time matches paused-guest sensor/CPU observations. Standard
+ * trace backend timestamps are not a substitute for this field. */
+static uint64_t nvme_audit_next_instance;
+#define NVME_AUDIT_FIELDS(n) qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), \
+    (n)->audit_instance, qatomic_inc_fetch(&(n)->audit_next_event)
+
+static void nvme_audit_boundary(NvmeCtrl *n, NvmeRequest *req,
+                                unsigned kind, uint64_t detail)
+{
+    if (n->audit_next_request) {
+        trace_pci_nvme_audit_boundary(NVME_AUDIT_FIELDS(n),
+            req ? req->audit_request : 0, kind, req ? req->status : 0, detail);
+    }
+}
